# Required. Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# Optional. Your server (guild) ID. Set this so slash commands appear immediately.
# Discord → Server Settings → Widget, or right-click the server with Developer Mode on.
DISCORD_GUILD_ID=

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=300
# Gemma 4 reasoning. true / false / low / medium / high
OLLAMA_THINK=true
SHOW_THINKING=false

# Conversation memory (in RAM, reset when the bot restarts)
HISTORY_LIMIT=20
HISTORY_CHAR_BUDGET=14000

# Comma-separated channel IDs where the bot replies to every message (not only @mentions)
# LISTEN_CHANNELS=123456789012345678

# Restrict the bot to specific servers. Empty = any server you invite it to.
# ALLOWED_GUILD_IDS=123456789012345678

RESPOND_TO_DMS=true

# Must match the Developer Portal toggle. Turn off if you only use /ask and @mentions.
MESSAGE_CONTENT_INTENT=true

# Type this in Discord instead of @mentioning the bot, e.g. !ai hello
COMMAND_PREFIX=!ai

# Reply when another bot @mentions you or replies to you
REPLY_TO_BOTS=true
BOT_REPLY_COOLDOWN=8

# Roast this user whenever they chat. 0 = no cooldown.
ROAST_USER_IDS=
ROAST_USERNAMES=
ROAST_COOLDOWN=0

# Roast another BOT whenever it talks (unprompted). Separate from the human roast
# target above so it can have its own cooldown.
# ROAST_BOT_IDS: the other bot's Discord user ID (Developer Mode -> right-click -> Copy User ID)
ROAST_BOT_IDS=
ROAST_BOT_USERNAMES=
# Seconds between roasts of the same bot. 300 = at most once every 5 minutes.
ROAST_BOT_COOLDOWN=300

# Owner-only DM feature. Only these Discord user IDs can make the bot DM
# someone with /dm or !dm. Leave EMPTY to disable DMing entirely.
# OWNER_IDS=123456789012345678
# Seconds before the same person can be DMed again.
DM_COOLDOWN=60

# Remember people across restarts (data/lore.json, data/history.json)
LORE_ENABLED=true
PERSIST_MEMORY=true
# Read image attachments. Needs a vision-capable model (e.g. gemma4:e4b-it-qat).
VISION_ENABLED=true
# Ambient presence. Keep these low - they fire without being asked.
REACTION_CHANCE=0.05
INTERJECT_CHANCE=0.02
INTERJECT_COOLDOWN=600

# Channels where the bot may act WITHOUT being tagged (roasts, interjections,
# reactions). Empty = every channel. @mentions and commands work everywhere.
# AMBIENT_CHANNELS=123456789012345678,234567890123456789

# Web search via Tavily (free tier 1000/month, no credit card). Results are treated
# as untrusted data and all URLs are stripped before the model sees them.
TAVILY_API_KEY=
SEARCH_ENABLED=false
SEARCH_MAX_PER_DAY=30
SEARCH_COOLDOWN=20

# Simos 18.10 Funktionsrahmen retrieval.
# Build the index first:
#   python frextract.py "path/to/Simos18.10 FR.pdf" --out data/fr_pages.jsonl
#   python build_fr_index.py
# Needs an embedding model: ollama pull bge-m3
FR_ENABLED=false
FR_INDEX_DIR=data/fr_index
FR_TOP_K=8
# Nothing is injected unless the best match scores at least this. Raise it if the
# bot starts quoting the FR at irrelevant moments.
FR_MIN_SCORE=0.50

# Chance the bot brings up a remembered callback on a given reply, plus a
# per-person cooldown in seconds. Callbacks also retire after a couple of uses so
# the same jab does not become a catchphrase. Set CALLBACK_CHANCE=0 to turn the
# needling off completely.
CALLBACK_CHANCE=0.25
CALLBACK_COOLDOWN=900

# The persona mocks people for missing the obvious. Left alone the model does this
# in well over half of replies, which gets tiring fast, so the rate is enforced in
# code. HIGHER = less mockery, LOWER = more. 0.45 lands around one reply in five.
STRAIGHT_CHANCE=0.65

# Song generation: "make a song about <member>" is SUNG - a clip (SONG_DURATION seconds) from a
# local ACE-Step 1.5 model (free, offline), posted as an MP3 with the lyrics.
# "…and type it here" / "just the lyrics" keeps it text. First request downloads
# several GB from huggingface.co. The song model and the image model do not both
# fit on an 8 GB card, so loading one evicts the other; each unloads after 2 idle
# minutes.
SONG_GEN_ENABLED=true
SONG_MODEL=ACE-Step/acestep-v15-xl-turbo-diffusers
SONG_DURATION=60
SONG_COOLDOWN=120
SONG_STEPS=8
# Also attach a sung clip under the 07:00 morning rap (off: text only).
DAILY_RAP_AUDIO=false

# One small model call (Gemini only) reads what a message addressed to the bot
# wants - picture, edit, song, question, web, archive - ahead of the keyword
# gates, which stay as the fallback. Off, or on a local model, the keywords
# decide alone as before.
INTENT_CLASSIFIER=true
# The classifier and the yes/no routers ignore GEMINI_THINKING_LEVEL (always minimal).
# Reactions on the bot's replies are scored per reply shape (data/feedback.json)
# and the shape roll leans toward what this server laughs at. "!feedback" shows
# the table (owner only).
FEEDBACK_ENABLED=true

# The bot may be pinged in any channel but every reply, picture and song lands
# in this one (channel ID), opening with who asked and where. 0 = reply in place.
REPLY_CHANNEL=

# For a model fine-tuned on the server chat by train/: ordinary chat is sent in
# its training format - a one-line system prompt and the last ~8 messages - with
# no persona prompt. Pictures, songs and logs still take the full path.
VOICE_MODE=false

# How much prompt wraps an ordinary chat reply:
#   full  - the whole persona harness (prompts/system.txt + mood, shapes, memory, material). Default.
#   lite  - the short persona in prompts/lite.txt + the last 8 messages + at most one short
#           fact block (archive or web). Tested well on hauhau-e4b.
#   voice - one line + the last 8 messages; for models fine-tuned by train/ (preston-style, voice).
# Pictures, songs and log reviews always take the full path. VOICE_MODE=true = HARNESS=voice.
HARNESS=full

# Which short prompt HARNESS=lite uses - one file per persona/model.
LITE_PROMPT=prompts/lite.txt

# Recent human messages the lite/voice harness shows the model (its own replies: up
# to half that, min 3). Fine-tuned models trained on ~8; more gives them more
# threads to wander into. Try 5-15.
LITE_CONTEXT=5

# Channel IDs exempt from REPLY_CHANNEL: pinged there, the bot answers there.
REPLY_IN_PLACE_CHANNELS=

# ---------------------------------------------------------------------------
# Gemini (cloud). Setting GEMINI_MODEL switches ALL chat onto the Gemini API;
# leave it blank to stay on Ollama. The owner can flip it live with /model.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# What "/model gemini" switches to when GEMINI_MODEL is blank.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# minimal / low / medium / high, or blank for the model default.
GEMINI_THINKING_LEVEL=
# Gemini has a far bigger context window, so it gets bigger budgets.
HISTORY_LIMIT_GEMINI=400
HISTORY_CHAR_BUDGET_GEMINI=300000
CONTEXT_MESSAGES=25
CONTEXT_CHARS=4000
CONTEXT_MESSAGES_GEMINI=150
CONTEXT_CHARS_GEMINI=40000

# A bigger local model for heavy jobs (log reviews, long answers). Blank = off.
OLLAMA_MODEL_HEAVY=
OLLAMA_NUM_CTX_HEAVY=131072

# ---------------------------------------------------------------------------
# Personality. The active persona lives in data/persona.json and is switched
# with /persona - see prompts/personas/README.md. These are only fallbacks.
SYSTEM_PROMPT_FILE=
# Reply length. The model picks a length per message; these are the ceilings.
REPLY_MAX_WORDS=80
REPLY_MAX_WORDS_LOCAL=40
REPLY_HARD_MAX_WORDS=1200
# Moods last 30-120 minutes per channel and change the delivery, not the persona.
MOODS_ENABLED=true
MOOD_MIN_MINUTES=30
MOOD_MAX_MINUTES=120
# Chance the persona is "a few drinks in" for a stretch (a typing style only).
DRUNK_CHANCE=0.2

# ---------------------------------------------------------------------------
# Chat archive retrieval (RAG over this server's own history). Build it first:
#   python scrape_chat.py       (pulls history to data/chat_index/raw.jsonl)
#   python build_chat_index.py  (embeds it with bge-m3 through Ollama)
# See docs/RAG.md.
CHAT_INDEX_ENABLED=false
CHAT_INDEX_DIR=data/chat_index
# A small model call decides whether a message needs the archive at all.
CHAT_INDEX_ROUTER=true

# Channel memory is folded into a running summary when it gets long.
SUMMARY_ENABLED=true
SUMMARY_WORDS=300
SUMMARY_WORDS_GEMINI=1200
SUMMARY_MAX_WORDS=500

# ---------------------------------------------------------------------------
# Pictures. Local generation on your GPU through diffusers (see docs/SETUP.md).
IMAGE_GEN_ENABLED=true
IMAGE_LOCAL_ENABLED=true
IMAGE_LOCAL_MODEL=Tongyi-MAI/Z-Image-Turbo
IMAGE_MODEL=
IMAGE_COOLDOWN=30

# ---------------------------------------------------------------------------
# Scheduled posts.
# The morning rap: a random persona roasts one member, in its own music genre.
DAILY_RAP_ENABLED=true
DAILY_RAP_CHANNEL=general
DAILY_RAP_TIME=07:00
# The Preston Awards: a weekly awards card from the week's chat. Day 0=Mon .. 6=Sun.
WEEKLY_AWARDS_ENABLED=true
WEEKLY_AWARDS_DAY=6
WEEKLY_AWARDS_TIME=18:00
